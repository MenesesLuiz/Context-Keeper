{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<BRAIN>/.context-keeper/scripts/session-start.sh\" \"<BRAIN>\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<BRAIN>/.context-keeper/scripts/checkpoint-stop.sh\" \"<BRAIN>\""
          }
        ]
      }
    ]
  }
}
